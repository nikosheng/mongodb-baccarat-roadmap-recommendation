# ===== MongoDB Atlas (M10+, vector search 已啟用) =====
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=baccarat_vector_demo

# ===== Voyage AI =====
VOYAGE_API_KEY=your_voyage_api_key_here
VOYAGE_BASE_URL=https://ai.mongodb.com/v1
VOYAGE_MODEL=voyage-3-large
VOYAGE_DIM=1024

# ===== Azure OpenAI (NL pattern 解析) =====
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_openai_key_here
AZURE_OPENAI_DEPLOYMENT=gpt-6-luna
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# ===== Match 閾值設定 (大路 pattern vector search) =====
PATTERN_MIN_SCORE=0.82
MIN_WINDOW_FOR_MATCH=4
MAX_WINDOW=10
TOP_K=5

# ===== NL Describer 版本控制 (大路) =====
NL_DESCRIBER_VERSION=1.0.0

# ===== 下三路 (Big Eye Boy / Small Road / Cockroach Pig) 第二組 vector search =====
# 已透過 `make calibrate-derived` 校準,預設 0.82 (詳見
# backend/app/seed/calibrate_derived.py 的計算依據)。如果修改了
# describe_derived_in_nl 的文字模板,請重新執行校準並更新此值。
DERIVED_PATTERN_MIN_SCORE=0.82
DERIVED_TOP_K=5
DERIVED_TAIL_LENGTH=12
NL_DERIVED_DESCRIBER_VERSION=3.0.0

# ===== Server =====
BACKEND_PORT=8000
FRONTEND_PORT=5173
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# ===== 開發用途:無 Voyage/Azure key 時可用假向量/假 LLM 跑通流程 =====
USE_MOCK_EMBEDDER=false
USE_MOCK_LLM=false
